{
  "$description": "Generated by `npm run tokens` from src/design/tokens.ts. Do not edit by hand.",
  "color": {
    "palette": {
      "ink": {
        "$type": "color",
        "$value": "#192022",
        "$description": "Primary text, icons, key outlines. On warm paper and light accent fills.",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "paper": {
        "$type": "color",
        "$value": "#F7F6F2",
        "$description": "Page background and calm negative space. Ink foreground; keeps pure white cards distinguishable.",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "forest": {
        "$type": "color",
        "$value": "#16372C",
        "$description": "Premium dark cards, brand text, primary CTA. White or lime text.",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "lime": {
        "$type": "color",
        "$value": "#D5F65C",
        "$description": "Highlight, progress complete, selected indicator. Ink text; never white. Invisible on paper (1.1:1), so always pair with an ink outline or icon.",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "green": {
        "$type": "color",
        "$value": "#22A64B",
        "$description": "Optimistic category tiles and success signal. Ink text only; white text fails AA (3.2:1).",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "orange": {
        "$type": "color",
        "$value": "#FA6B33",
        "$description": "Playful “how it works” and interest cards. Ink text; a warm accent, never an error.",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "blue": {
        "$type": "color",
        "$value": "#415EC8",
        "$description": "Secondary category, information, focus ring. White text (5.7:1).",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "red": {
        "$type": "color",
        "$value": "#D72839",
        "$description": "Negative / error meaning when truly necessary. White text; always with icon, heading and explanation.",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "sage": {
        "$type": "color",
        "$value": "#889B62",
        "$description": "Subtle cards, chips, low-intensity accents. Ink text.",
        "$extensions": {
          "com.dfx.source": "brief"
        }
      },
      "peach": {
        "$type": "color",
        "$value": "#EAC6B5",
